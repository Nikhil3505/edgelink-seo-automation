# Edgelink Technology - SEO Automation Dashboard Environment Variables

# Mock Toggle Switch (Section 2.1 & 2.2)
# Set to 'true' to use mock data for crawlers, GSC, PageSpeed, DataForSEO, Twilio, and Claude
# Set to 'false' to connect to live external APIs
USE_MOCKS=true

# Database (Section 5: Supabase / Neon PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/edgelink_seo?schema=public"

# Redis Queue (Section 3.1 & 4.1: Upstash Redis for BullMQ)
UPSTASH_REDIS_URL="rediss://default:token@your-upstash-redis.upstash.io:6379"
REDIS_URL="redis://localhost:6379"

# AI Analysis Engine (Section 3.1 & 7.2: Anthropic Claude API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Google PageSpeed Insights API Key (Optional when USE_MOCKS=true)
PAGESPEED_API_KEY=""

# Google Search Console OAuth2 Token (Optional when USE_MOCKS=true)
GOOGLE_SEARCH_CONSOLE_TOKEN=""

# DataForSEO Credentials (Optional when USE_MOCKS=true)
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Twilio WhatsApp Credentials (Optional when USE_MOCKS=true)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Next.js Port
PORT=3000
